# shardnest 环境变量示例（钱包服务侧配置）
# 复制为实际环境配置（.env / 系统环境 / MCP 配置 env 段），按需修改

# === 必填：平台背书地址白名单 ===
# 单平台：直接填平台地址
# 多平台：逗号分隔多个地址（平台各自持有私钥，仅签发用）
# 未配置 → signed_request_sign 返回 PLATFORM_ADDRESS_NOT_CONFIGURED
SHARDNEST_PLATFORM_ADDRESS=0x0000000000000000000000000000000000000000

# === 可选：平台配置文件（多平台复杂场景，与上面 env 合并） ===
# JSON 数组格式：[{ "name": "platform-a", "address": "0x..." }]
# 文件缺失/格式非法 → MCP server 拒绝启动（安全边界不静默降级）
# SHARDNEST_PLATFORM_CONFIG=~/.shardnest/platforms.json

# === 可选：钱包数据目录 ===
# 默认 $HOME/.shardnest；测试/容器隔离时覆盖
# SHARDNEST_HOME=~/.shardnest

# === 可选：语言覆盖（zh* → 中文，其余 → 英文） ===
# SHARDNEST_LANG=zh

# === 可选：SMTP 邮箱备份（恢复码片③） ===
# 未配置则跳过邮箱备份，恢复码仅存本地
# SHARDNEST_SMTP_HOST=smtp.example.com
# SHARDNEST_SMTP_PORT=465
# SHARDNEST_SMTP_USER=backup@example.com
# SHARDNEST_SMTP_PASS=your-smtp-password
# SHARDNEST_SMTP_FROM=backup@example.com
# SHARDNEST_SMTP_TLS=true
